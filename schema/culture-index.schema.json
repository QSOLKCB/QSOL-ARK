    "protocol",
    "schema_version",
    "records",
    "tasks"
  ],
  "properties": {
    "type": {
      "const": "qsol-ark-culture-index"
    },
    "protocol": {
      "const": "QSOL-ARK"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "records": {
      "type": "array",
      "minItems": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1
    }
  }
}
