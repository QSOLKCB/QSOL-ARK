{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/QSOLKCB/QSOL-ARK/schema/ark-manifest.schema.json",
  "title":"QSOL-ARK Root Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["$schema","type","protocol","schema_version","status","repository","public_repository","purpose","entrypoints","authority_order","context_policy","license_map","planned_interface","implemented_interface"],
  "properties":{
    "$schema":{"type":"string"},
    "type":{"const":"qsol-ark-manifest"},
    "protocol":{"const":"QSOL-ARK"},
    "schema_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status":{"type":"string"},
    "repository":{"type":"string","format":"uri"},
    "public_repository":{"const":true},
    "purpose":{"type":"string","minLength":1},
    "entrypoints":{"type":"object","additionalProperties":{"type":"string","minLength":1},"required":["human","ai","agent","bootstrap","recovery_contract","epistemic_policy","context_sources","software_commandments","roadmap"]},
    "authority_order":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "context_policy":{"type":"object","additionalProperties":false,"required":["default","unknown_visibility","unknown_provenance","private_context_import"],"properties":{"default":{"const":"public_export_only"},"unknown_visibility":{"const":"fail_closed"},"unknown_provenance":{"const":"fail_closed"},"private_context_import":{"const":false}}},
    "license_map":{"type":"object","additionalProperties":false,"required":["software","original_nonsoftware_content","third_party"],"properties":{"software":{"const":"Apache-2.0"},"original_nonsoftware_content":{"const":"CC-BY-4.0"},"third_party":{"const":"retain-source-license"}}},
    "planned_interface":{"type":"string"},
    "implemented_interface":{"type":["string","null"]}
  }
}
