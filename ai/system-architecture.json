    "architecture": [
      "canonical-state",
      "generate-actions",
      "deterministic-order",
      "apply",
      "search",
      "alpha-beta-prune",
      "quiescence-or-instability-extension",
      "undo",
      "verify-original-state"
    ],
    "required_invariant": "UNDO(APPLY(STATE,ACTION)) == STATE",
    "receipt_rule": "MODEL_SAYS_IT_SEARCHED != SEARCH_EXECUTED"
