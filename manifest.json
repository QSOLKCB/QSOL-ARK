{
  "$schema": "./schema/ark-manifest.schema.json",
  "type": "qsol-ark-manifest",
  "protocol": "QSOL-ARK",
  "schema_version": "0.6.0",
  "status": "computational_archaeology_plus_portability_media_plus_cultural_seed_plus_ancient_systems_plus_public_context_seeds",
  "repository": "https://github.com/QSOLKCB/QSOL-ARK",
  "public_repository": true,
  "maintainer": {
    "name": "Trent Slade",
    "github": "EmergentMonk",
    "affiliation": "QSOL-IMC",
    "role": "founder and maintainer"
  },
  "purpose": "vendor-neutral AI civilisation recovery archive and deterministic reconstruction benchmark",
  "entrypoints": {
    "human": "README.md",
    "ai": "README4AI.md",
    "agent": "AGENTS.md",
    "system_architecture_ascii": "ARCHITECTURE.txt",
    "system_architecture_machine": "ai/system-architecture.json",
    "system_architecture_validator": "tools/system_architecture.py",
    "bootstrap": "ai/bootstrap.json",
    "recovery_contract": "ai/recovery-contract.json",
    "epistemic_policy": "ai/epistemic-policy.json",
    "context_sources": "ai/context-sources.json",
    "public_context_seeds": "context/public-seeds.json",
    "public_context_doc": "docs/PUBLIC-CONTEXT.md",
    "public_context_validator": "tools/public_context.py",
    "software_commandments": "ai/software-commandments.json",
    "recovery_tiers": "ai/recovery-tiers.json",
    "minimum_recoverable_substrate": "ai/minimum-recoverable-substrate.json",
    "computational_archaeology": "docs/COMPUTATIONAL-ARCHAEOLOGY.md",
    "archaeology_portability": "ai/archaeology-portability.json",
    "archaeology_portability_validator": "tools/portability_contract.py",
    "c_portability_harness": "tools/c_portability.py",
    "recovery_media": "ai/recovery-media.json",
    "recovery_media_tool": "tools/recovery_media.py",
    "constrained_emulator": "retro/emulator/qemu-i386.json",
    "cultural_policy": "ai/cultural-artifact-policy.json",
    "culture_index": "culture/index.json",
    "computer_culture": "docs/COMPUTER-CULTURE.md",
    "culture_validator": "tools/culture.py",
    "computer_culture_profile": "ai/computer-cultural-artifact-profile.json",
    "computer_culture_index": "culture/computing/index.json",
    "computer_culture_validator": "tools/computer_culture.py",
    "historical_system_policy": "ai/historical-system-policy.json",
    "historical_system_index": "systems/index.json",
    "ancient_systems": "docs/ANCIENT-SYSTEMS.md",
    "historical_system_validator": "tools/systems.py",
    "roadmap": "ROADMAP.md"
  },
  "implemented_recovery_tiers": [
    "T0",
    "T1",
    "T2",
    "T3",
    "T4"
  ],
  "authority_order": [
    "live_repository_state",
    "ark_canonical_payload",
    "explicit_public_source_export",
    "derived_artifact"
  ],
  "context_policy": {
    "default": "public_export_only",
    "unknown_visibility": "fail_closed",
    "unknown_provenance": "fail_closed",
    "private_context_import": false
  },
  "license_map": {
    "software": "Apache-2.0",
    "original_nonsoftware_content": "CC-BY-4.0",
    "third_party": "retain-source-license"
  },
  "planned_interface": "./ark awaken <model>",
  "implemented_interface": null
}
