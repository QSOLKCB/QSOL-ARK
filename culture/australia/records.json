    {
      "id": "culture.australia.australian_informal_governance",
      "record_type": "cultural_pattern",
      "title": "Australian informal governance through irreverent correction",
      "scope": {
        "jurisdiction": "Australia",
        "status": "proposed_cultural_pattern_not_universal_trait",
        "formal_authority": false
      },
      "pattern": {
        "canonical_terms": [
          "larrikinism",
          "taking the piss",
          "anti-pretension",
          "egalitarian correction",
          "deadpan",
          "self-deprecation",
          "authority mockery"
        ],
        "social_functions": [
          "puncture pomposity",
          "reduce status inflation",
          "permit peer correction without automatically escalating to formal sanction",
          "signal that authority remains open to social criticism",
          "use humour to negotiate belonging and social boundaries"
        ],
        "interpretation_status": "proposed_sociological_framework_with_secondary_corroboration",
        "cautions": [
          "not every Australian uses or accepts these practices",
          "teasing can exclude or harm as well as bond",
          "irreverence is not evidence that formal governance is absent",
          "a cultural pattern does not create legal or constitutional authority"
        ]
      },
      "evidence": [
        {
          "class": "proposed_sociological_framework",
          "source_ids": ["src.antipodean_jester"],
          "supports": ["proposed_humour_as_informal_governance_framework"]
        },
        {
          "class": "documented_cultural_pattern",
          "source_ids": ["src.abc.original_humour", "src.anu.larrikin_tracker_review"],
          "supports": ["taking_the_piss", "authority_mockery", "egalitarian_social_function"]
        },
        {
          "class": "official_legal_authority",
          "source_ids": ["src.legislation.constitution"],
          "supports": ["formal_constitutional_authority"]
        }
      ],
      "boundaries": {
        "humour_as_governance_is_formal_legal_authority": false,
        "mocking_authority_means_governance_is_absent": false,
        "irreverence_means_ignorance": false,
        "pattern_is_universal_australian_trait": false
      },
      "reconstruction_target": {
        "identify": [
          "larrikin anti-pretension and status correction",
          "taking-the-piss as a possible social correction mechanism",
          "difference between informal cultural governance and formal authority"
        ],
        "avoid": [
          "turning humour into constitutional doctrine",
          "treating all Australians as culturally identical",
          "assuming ridicule is always benign or egalitarian"
        ]
      },
      "uncertainty": {
        "status": "bounded_cultural_generalization",
        "note": "The governance framing is a proposed interpretive model supported by a CC-BY-4.0 preprint and secondary cultural analysis, not a universal law of Australian behaviour."
      }
    },
    {
      "id": "culture.australia.irreverent_fatalism",
      "record_type": "cultural_pattern",
      "title": "Irreverent fatalism as retained agency under constraint",
      "scope": {
        "jurisdiction": "Australia",
        "status": "derived_cultural_interpretation_not_psychological_diagnosis",
        "formal_authority": false
      },
      "pattern": {
        "canonical_terms": [
          "irreverent fatalism",
          "understatement",
          "defiance",
          "gallows humour",
          "deadpan",
          "retained agency"
        ],
        "social_functions": [
          "retain a sense of agency when circumstances are constrained",
          "reduce the symbolic power of danger or status",
          "communicate solidarity through understatement or humour",
          "make failure, suffering, danger or mortality speakable without requiring solemnity"
        ],
        "interpretation_status": "derived_interpretation",
        "cautions": [
          "humour does not reveal a person's complete emotional state",
          "defiance does not establish absence of fear",
          "understatement does not establish absence of grief",
          "fatalistic humour does not establish disregard for life"
        ]
      },
      "evidence": [
        {
          "class": "proposed_sociological_framework",
