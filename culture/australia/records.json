        },
        {
          "class": "derived_interpretation",
          "source_ids": ["src.nma.hawke_larrikin_grief"],
          "supports": ["hawke_larrikin_leader_description", "gentler_response_to_grief"]
        }
      ],
      "boundaries": {
        "fatalistic_humour_is_nihilism": false,
        "humour_proves_absence_of_grief": false,
        "humour_proves_absence_of_fear": false,
        "humour_proves_disregard_for_life": false,
        "retained_agency_is_derived_interpretation": true
      },
      "reconstruction_target": {
        "identify": [
          "humour or understatement as a possible form of retained agency under constraint",
          "difference between fatalistic humour and nihilism",
          "limits on inferring internal emotion from outward humour"
        ],
        "avoid": [
          "claiming a joking person felt no fear or grief",
          "romanticising danger or suffering",
          "promoting an anecdote or legend into universal national psychology"
        ]
      },
      "uncertainty": {
        "status": "interpretive_not_diagnostic",
        "note": "Retained agency is an allowed cultural interpretation when supported by context; it is not direct evidence of a person's private emotional state."
      }
    },
